@echo off
title SDL3 手柄实测（Phase 0 探针 live 模式）
cd /d D:\CTLIB

echo ==============================================================
echo   SDL3 手柄实测 —— 验证「按键位置化归一 / 摇杆方向 / 热插拔」
echo ==============================================================
echo.
echo   请做这几件事，观察屏幕输出：
echo.
echo   [1] 插好手柄（蓝牙手柄请先配对）
echo   [2] 依次按 A / B / X / Y —— 屏幕应分别显示
echo       按下 SOUTH / EAST / WEST / NORTH（位置化命名，两类手柄一致）
echo   [3] 按方向键、肩键、扳机 —— 屏幕应显示对应名称与数值变化
echo   [4] 慢慢推左摇杆「向上」—— 应显示 轴[1] 变为负值
echo       （SDL 约定上推为负；我们代码里已取反成「上=正」）
echo   [5] 拔掉再插回手柄 —— 应看到设备数量变化（热插拔）
echo.
echo   共 90 秒，按任意键开始...
pause >nul
cls

call flutter\bin\dart.bat run dev_probe\sdl3_probe.dart live 90

echo.
echo ==============================================================
echo   结束。把上面输出保存下来发回给 AI 即可。
echo ==============================================================
echo.
pause
