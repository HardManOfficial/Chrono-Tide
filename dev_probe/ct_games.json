1f1_87e8_15d515f407e2_2thgt5fshz.jpg","6cac7910_9b1f_11f1_87e8_15d515f407e2_x2huzvhkyc.jpg","6cadb190_9b1f_11f1_87e8_15d515f407e2_pavv8s027h.jpg"],"tags":["日常","恋爱"],"title":"ATRI","traditionalChineseTitle":"","updated":"2026-10-05 05:56:08.277Z","version":"官方中文","versionNote":"","voteCount":4},{"Developer":"Lose社","bannerUrl":"banner_5932371594_epnoq7lbkb.webp","collectionId":"pbc_879072730","collectionName":"games","community_count":0,"contributors":null,"coverUrl":"1602741754_962560_hfrb0u4rd8.png","created":"2026-04-29 10:39:56.265Z","creator_name":"","description":"控制铁路列车的人形部件——铁路人偶。\r\n\r\n前帝国铁路8620型蒸汽机车首车，8620的专用铁路人偶八六，也如其他众多铁路人偶一样，随着大废线被弃用，陷入了长眠。\r\n\r\n一位名叫右田双铁的少年在受大废线影响而发生的事故中失去了家人，后被经营隈元县御一夜市酿酒厂的右田家收为养子。\r\n\r\n长大成人后考取了帝大的他，为使第二故乡免于因引资建厂而使水质遭到污染，回到了御一夜。\r\n\r\n在那里，他意外地唤醒了八六，继而成为了她的主人。\r\n\r\n双铁与八六，为达成各自不同的目的，下定决心寻找下落不明的蒸汽机车8620。\r\n\r\n在双铁热爱绘画的继妹日日姬与御一夜市长兼御一夜铁路社长波莱特的鼎力支持下，向着令8620复活的目标，携手共同努力。\r\n\r\n合集内容","downloadUrl":"/Lovetrianlastrun.rar.lz4","englishTitle":"Maitetsu - Last Run!!","estimatedMinutes":0,"file_size":0,"has_official":true,"id":"tu7i8f1nuwcwe3t","installCount":0,"like_count":0,"metaSource":"VNDB","origin":"official","originalTitle":"まいてつ Last Run!!","owner":"","rating":8.41,"releaseDate":"2020-10-30","review_status":"approved","screenshots":["ca2b9f60_6fbb_11f1_999b_f7ba3a97a3bf_o875wmud4b.jpg","ca26bd60_6fbb_11f1_999b_f7ba3a97a3bf_hzealn03aa.jpg","caa0cf60_6fbb_11f1_999b_f7ba3a97a3bf_3amewzn2sx.jpg","ca431f00_6fbb_11f1_999b_f7ba3a97a3bf_y5uoc9s2zx.jpg","ca82c010_6fbb_11f1_999b_f7ba3a97a3bf_uh5v6aomhm.jpg","ca44a5a0_6fbb_11f1_999b_f7ba3a97a3bf_gjhojppmmr.jpg"],"tags":["废萌","剧情"],"title":"爱上火车Last Run","traditionalChineseTitle":"","updated":"2026-10-05 05:56:08.455Z","version":"","versionNote":"","voteCount":383},{"Developer":"CLOCKUP","bannerUrl":"banner_3402358836_vdua4jxox0.webp","collectionId":"pbc_879072730","collectionName":"games","community_count":0,"contributors":null,"coverUrl":"v2_ed4fcdf41ca5bf4c58b36028afea0784_r_n01eykju9g.png